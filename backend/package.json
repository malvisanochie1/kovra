{
  "name": "@kovra/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@kovra/shared": "1.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "cors": "^2.8.6",
